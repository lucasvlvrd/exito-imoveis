# Production domain, used for metadataBase, sitemap.xml, robots.txt, canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=https://www.exitoemimoveis.com.br

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code (the content value of the meta tag).
# Leave blank until you verify the property in Search Console.
GOOGLE_SITE_VERIFICATION=

# When "true", every page is replaced with an "em breve" (coming soon) notice for visitors,
# and robots.txt disallows all crawling. Set to "false" (or unset) to show the real site.
MAINTENANCE_MODE=false

# Secret used to bypass maintenance mode: visit /?preview=<this value> once to set a
# long-lived cookie that grants full access. Generate with: openssl rand -hex 24
MAINTENANCE_BYPASS_SECRET=
